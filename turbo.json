{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [
    ".github/workflows/ci.yml",
    "eslint.config.js",
    "mise.toml",
    "pyproject.toml",
    "tsconfig.base.json",
    "uv.lock"
  ],
  "tasks": {
    "lint": {},
    "typecheck": {},
    "test": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "e2e": {
      "cache": false
    },
    "//#lint": {
      "inputs": [".claude/hooks/**", ".github/tests/**", "bench/**", "db/**", "!**/__pycache__/**", "!**/.ruff_cache/**"]
    },
    "//#typecheck": {
      "inputs": [".claude/hooks/**", ".github/tests/**", "bench/**", "db/**", "!**/__pycache__/**", "!**/.ruff_cache/**"]
    },
    "//#test": {
      "inputs": [
        ".claude/hooks/**",
        ".claude/settings.json",
        ".devcontainer/Dockerfile",
        ".github/**",
        "db/**",
        "pnpm-workspace.yaml",
        "prov/**",
        "!**/__pycache__/**",
        "!**/.ruff_cache/**"
      ]
    }
  }
}
